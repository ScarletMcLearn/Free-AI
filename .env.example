# Copy to .env and fill only free-tier keys you want enabled.
# Never paste paid-provider keys here.

# Kilo Gateway account/session is configured by Kilo. Use only Auto Free:
FREE_AI_MODEL=kilo/kilo-auto/free

# Optional direct free-provider keys for doctor/test visibility.
NVIDIA_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Hard guard. Keep 0.
MAX_COST_USD=0
