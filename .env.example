# Copy to .env and fill only free-tier keys you want enabled.
# Never paste paid-provider keys here.

# Kilo Gateway free route. Router uses only kilo/kilo-auto/free upstream.
KILO_API_KEY=

# Optional. Disabled/skipped unless configured; not required for Bangladesh setup.
NVIDIA_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Hard guard. Keep 0.
MAX_COST_USD=0
