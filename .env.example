# Copy to .env and fill only free-tier keys you want enabled.
# Never paste paid-provider keys here. Keep values blank in this example.

# Existing free providers
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Cohere
COHERE_API_KEY=

# Cloudflare Workers AI. Both are required for Cloudflare to be configured.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Mistral
MISTRAL_API_KEY=

# SambaNova
SAMBANOVA_API_KEY=

# Optional only. Disabled/skipped unless configured.
NVIDIA_API_KEY=
KILO_API_KEY=

# Hard guard. Keep 0.
MAX_COST_USD=0
